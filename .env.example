# Vercel Environment Variables (https://vercel.com/[proje]/settings/environment-variables)

# Firebase Service Account JSON (tek satırda, tırnaklar içinde)
# Firebase Console -> Project Settings -> Service Accounts -> "Generate new private key"
# Dosyadaki JSON'u al, tüm satırları tek satır yap ve buraya yapıştır
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}
